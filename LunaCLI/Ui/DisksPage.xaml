<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zenless.Ui.DisksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="12,8,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Disk Drives" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Subtitle" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="New disk drive"
                VerticalAlignment="Center"
                Click="NewDisk_Click" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="CardHost" />
        </ScrollViewer>
    </Grid>
</Page>
