<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Zenless.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="InkBrush" Color="#FF121214" />
            <SolidColorBrush x:Key="CardBrush" Color="#FF1C1C22" />
            <SolidColorBrush x:Key="LineBrush" Color="#FF3A3A44" />
            <SolidColorBrush x:Key="PaperBrush" Color="#FFF4F1EA" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FFA8A296" />
            <SolidColorBrush x:Key="GoldBrush" Color="#FFE7B008" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
